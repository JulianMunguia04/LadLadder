<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/player.css">
  <title>Lad Ladder</title>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/socketPlayerClient.js" defer></script>
</head>
<body>
  <nav>
    Nav
  </nav>
  <main id="main">
    <div id="name-phase">
      <h1>Enter your Name</h1>
      <div class="container"> 
        <input class="name-input" id="playerName" type="text" maxlength="12">
        <button class="join-button" id="join-button">Join</button>
      </div>
    </div>
    <div id="prompt-phase" class="displayNone">
      <h1>Write your own Question:</h1>
      <div class="input-option-flex">
        <input id = "question-input" maxlength="65">
        <button id="good-or-bad">Good</button>
      </div>
      <div id="attribute-options">
        <button class="options intelligence">Intelligence</button>
        <button class="options morality">Morality</button>
        <button class="options charisma">Charisma</button>
        <button class="options luck">Luck</button>
        <button class="options humor">Humor</button>
        <button class="options creativity">Creativity</button>
        <button class="options achievement">Humor</button>
        <button class="options intelligence">Achievement</button>
        <button class="options strength">Strength</button>
        <button class="options effort">Effort</button>
      </div>
      <button id="send-question">
        Done
      </button>
    </div>
    <div id="rank-phase" class="displayNone">
      <h1 id="rank-question">Answer The Following Question</h1>
      <h3>Low ----------------- High</h3>
      <div id="ranking-section" class="ranking-section" ondrop="drop(event)" ondragover="allowDrop(event)">
      </div>
      <div id="players-container" class="players-list">
        <!-- This section will be populated dynamically with player data -->
      </div>
      <button id="submit-ranking">Submit Ranking</button>
    </div>
    <div id="end-game-phase" class="displayNone">
      <h1>See Final Results On Screen</h1>
    </div>
  </main>
  <footer>
  </footer>
</body>
</html>

